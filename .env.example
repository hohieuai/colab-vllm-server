# Copy to .env.local and adjust. .env.local is not committed.
#
#   cp .env.example .env.local

# The OpenAI SDKs read these two variables. The API key is a placeholder. The
# server accepts "vllm" unless VLLM_API_KEY is set, and it is reachable only
# through your SSH tunnel. Local ports start at 8000, one per running endpoint.
# To set the URL of a running endpoint, run:
#
#   uv run serve env <preset> --write
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=vllm

# Hugging Face token, passed to the server by `serve up`. Gated models need it.
# It also raises download rate limits.
HF_TOKEN=

# Optional. The API key the server requires. Default: vllm.
# VLLM_API_KEY=

# Optional. Path to the colab CLI if it is not on PATH.
# COLAB_BIN=/Users/you/.local/bin/colab
